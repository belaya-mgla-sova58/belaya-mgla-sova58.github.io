
/* ===== v622: mobile/desktop view switch ===== */
.view-mode-v622{
  display:none;
  margin:14px 4px 6px;
  padding:10px;
  border:1px solid rgba(132,205,255,.24);
  border-radius:14px;
  background:rgba(255,255,255,.045);
  box-sizing:border-box;
}
.view-mode-v622-title{
  margin:0 0 8px;
  color:#cfeaff;
  font-size:11px;
  font-weight:900;
  letter-spacing:.04em;
  text-transform:uppercase;
  text-align:center;
}
.view-mode-v622-buttons{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.view-mode-v622 button{
  min-width:0!important;
  min-height:38px!important;
  height:auto!important;
  padding:7px 6px!important;
  border:1px solid rgba(137,206,255,.26)!important;
  border-radius:10px!important;
  background:rgba(17,73,121,.58)!important;
  color:#eaf7ff!important;
  font-size:11px!important;
  font-weight:850!important;
  line-height:1.15!important;
  cursor:pointer;
}
.view-mode-v622 button.active{
  background:linear-gradient(145deg,#2d83c8,#1d5f99)!important;
  border-color:#84d1ff!important;
  box-shadow:0 0 12px rgba(92,190,255,.22)!important;
}
.view-mode-float-v622{
  display:none;
  position:fixed;
  top:8px;
  right:8px;
  z-index:200000;
  min-height:34px;
  padding:6px 10px;
  border:1px solid rgba(142,211,255,.50);
  border-radius:10px;
  background:rgba(7,43,78,.92);
  color:#fff;
  font:800 12px/1.1 system-ui,-apple-system,"Segoe UI",sans-serif;
  box-shadow:0 7px 20px rgba(0,12,30,.28);
}
@media (max-width:1200px), (hover:none), (pointer:coarse){
  .view-mode-v622{display:block;}
}

/* Force a real desktop-like layout on a phone when the saved mode is desktop. */
html.force-desktop-root body{
  min-width:1280px!important;
}
html.force-desktop-root body .mobile-topbar,
html.force-desktop-root body .mobile-nav-overlay,
html.force-desktop-root body #mobileMenuToggle{
  display:none!important;
}
html.force-desktop-root body .view-mode-float-v622{display:block!important;}
html.force-desktop-root body .nav-wrap{
  position:fixed!important;
  top:0!important;
  left:0!important;
  right:auto!important;
  bottom:0!important;
  width:205px!important;
  max-width:205px!important;
  height:100vh!important;
  margin:0!important;
  padding:106px 8px 20px!important;
  overflow-y:auto!important;
  overflow-x:hidden!important;
  transform:none!important;
  border-radius:0!important;
  box-sizing:border-box!important;
  z-index:10040!important;
}
html.force-desktop-root body .nav-wrap>.sidebar-exact-logo{
  display:block!important;
  position:absolute!important;
  top:14px!important;
  left:50%!important;
  transform:translateX(-50%)!important;
  width:164px!important;
  max-width:164px!important;
  height:auto!important;
  margin:0!important;
}
html.force-desktop-root body .nav-wrap>nav{
  display:flex!important;
  flex-direction:column!important;
  width:100%!important;
  gap:3px!important;
  margin:0!important;
  padding:0!important;
}
html.force-desktop-root body .nav-wrap>nav>a,
html.force-desktop-root body .nav-wrap>nav>a.route-link{
  display:flex!important;
  align-items:center!important;
  width:100%!important;
  min-height:42px!important;
  height:auto!important;
  margin:0!important;
  padding:7px 8px!important;
  gap:7px!important;
  border-radius:10px!important;
  font-size:13px!important;
  line-height:1.15!important;
  white-space:normal!important;
  box-sizing:border-box!important;
}
html.force-desktop-root body .nav-wrap nav a .sidebar-color-icon,
html.force-desktop-root body .nav-wrap nav a .state-position-menu-icon{
  display:block!important;
  width:28px!important;
  height:28px!important;
  min-width:28px!important;
  flex:0 0 28px!important;
  object-fit:contain!important;
}
html.force-desktop-root body .view-mode-v622{display:block!important;}
html.force-desktop-root body main,
html.force-desktop-root body main#appMain,
html.force-desktop-root body #appMain{
  margin-left:205px!important;
  width:calc(100% - 205px)!important;
  max-width:none!important;
  min-width:0!important;
  padding:14px 16px 60px!important;
  box-sizing:border-box!important;
}
html.force-desktop-root body main#appMain>.route-page.active,
html.force-desktop-root body #appMain>.route-page.active{
  width:100%!important;
  max-width:none!important;
  min-width:0!important;
  margin:0!important;
  padding-left:0!important;
  padding-right:0!important;
  box-sizing:border-box!important;
}
html.force-desktop-root body .site-search-v426,
html.force-desktop-root body .breadcrumbs-v409,
html.force-desktop-root body .page-heading-v424,
html.force-desktop-root body .guide-page-v69,
html.force-desktop-root body .page-shell,
html.force-desktop-root body .content-wrap{
  width:100%!important;
  max-width:none!important;
  margin-left:0!important;
  margin-right:0!important;
  box-sizing:border-box!important;
}
html.force-desktop-root body .hero,
html.force-desktop-root body.is-home-route .hero,
html.force-desktop-root body:not(.is-home-route) .hero{
  margin-left:205px!important;
  width:calc(100% - 205px)!important;
  max-width:none!important;
  min-height:230px!important;
  height:260px!important;
  padding:0!important;
  border-radius:0!important;
  box-sizing:border-box!important;
  background-size:cover!important;
}
html.force-desktop-root body .ui-tabsbar{
  margin-left:205px!important;
  width:calc(100% - 205px)!important;
  min-height:70px!important;
  height:auto!important;
  padding:10px 16px!important;
  display:flex!important;
  flex-wrap:wrap!important;
  gap:9px!important;
  box-sizing:border-box!important;
}
html.force-desktop-root body .ui-tabsbar button{
  min-width:132px!important;
  height:44px!important;
  padding:0 14px!important;
  font-size:14px!important;
  white-space:nowrap!important;
}
html.force-desktop-root body .home-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;}
html.force-desktop-root body .quick-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important;}
html.force-desktop-root body .event-grid,
html.force-desktop-root body .resource-grid,
html.force-desktop-root body .mail-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;}
html.force-desktop-root body .expert-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;}
html.force-desktop-root body .pet-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;}
html.force-desktop-root body img,
html.force-desktop-root body video,
html.force-desktop-root body canvas,
html.force-desktop-root body svg{max-width:100%!important;}
html.force-desktop-root body img,
html.force-desktop-root body video{height:auto!important;}
